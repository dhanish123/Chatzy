{
  "builds": [
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "cd web && npm install && npm run build",
        "outputDirectory": "web/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "web/dist/$1"
    }
  ]
}
